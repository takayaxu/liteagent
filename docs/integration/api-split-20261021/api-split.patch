+        # archives, PDFs, and unknown extensions remain content-sensitive.
+        return suffix in {
+            "py", "js", "jsx", "ts", "tsx", "java", "c", "h", "cpp", "cc",
+            "cxx", "go", "rs", "rb", "php", "swift", "kt", "kts", "scala",
+            "sh", "bash", "zsh", "fish", "sql", "html", "css",
+        }
