+                root_list = [str(root) for root in roots] if isinstance(roots, list) else []
+                marker = {
+                    "complete": True,
+                    "observed_roots": root_list,
+                    "observed_entries": matches,
+                    "destination_directories": destinations,
+                    "next_required_phase": "classify_and_move",
