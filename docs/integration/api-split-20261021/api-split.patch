+            {
+                "source_sheet": "Sheet1",
+                "source_range": "B2:B3",
+                "destination_sheet": "Sheet1",
+                "destination": "C2",
+                "transform": "trim",
+            },
+        )
+
+    assert caught.value.code == "INVALID_REQUEST"
+    assert all(not cell.writes for cell in destination_cells)
