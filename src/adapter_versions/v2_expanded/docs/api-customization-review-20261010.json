                  "at_column",
                  "bounded",
                  "off",
                  "on"
                ],
                "description": "Text wrapping behavior: off, on at the viewport, at_column at the configured column, or bounded at the smaller of viewport and column."
              },
              "word_wrap_column": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Positive editor column used by at_column or bounded wrapping. This may also be changed independently of the current word-wrap mode."
              },
