    {
      "domain": "vlc",
      "action": "preferences.configure",
      "tool": {
        "type": "function",
        "function": {
          "name": "adapter__preferences_configure",
          "description": "Execute the deterministic vlc.preferences.configure Adapter action. Pass the documented action params directly as top-level tool arguments. Use only documented parameter names.",
          "parameters": {
            "type": "object",
            "properties": {
              "global_play_pause_hotkey": {
                "type": "string",
                "minLength": 1,
                "description": "VLC global Play/Pause key name, for example Media Play Pause."
              },
              "maximum_volume_percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 300,
                "description": "Maximum volume shown by the VLC Qt interface, as a percentage."
              },
              "volume_slider_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "description": "One #RRGGBB color applied to all VLC volume-slider states."
              },
              "minimal_interface": {
                "type": "boolean",
                "description": "True hides the normal playback controls in window mode."
              },
              "exit_after_playback": {
                "type": "boolean",
                "description": "Whether VLC exits automatically when playback ends."
              },
              "allow_multiple_instances": {
                "type": "boolean",
                "description": "Whether desktop-opened files may start independent VLC instances."
              },
              "show_background_cone": {
                "type": "boolean",
                "description": "Whether the VLC cone is shown in the empty-player background."
              },
              "recording_directory": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/.*",
                "description": "Explicit absolute directory where VLC stores recordings, for example /srv/media/captures. Use recording_location instead when the request names a standard user directory without an absolute path."
              },
              "recording_location": {
                "type": "string",
                "enum": [
                  "desktop",
                  "downloads",
                  "videos",
                  "music",
                  "home"
                ],
                "description": "Standard directory under the active user's home. Select this when the request says Desktop, Downloads, Videos, Music, or the home directory without giving an absolute path."
              }
            },
            "required": [],
            "additionalProperties": false,
            "allOf": [
              {
                "not": {
                  "required": [
                    "recording_directory",
                    "recording_location"
                  ]
                }
              }
            ],
            "anyOf": [
              {
                "required": [
                  "global_play_pause_hotkey"
                ]
              },
              {
                "required": [
                  "maximum_volume_percent"
                ]
              },
              {
                "required": [
                  "volume_slider_color"
                ]
              },
              {
                "required": [
                  "minimal_interface"
                ]
              },
              {
                "required": [
                  "exit_after_playback"
                ]
              },
              {
                "required": [
                  "allow_multiple_instances"
                ]
              },
              {
                "required": [
                  "show_background_cone"
                ]
              },
              {
                "required": [
                  "recording_directory"
                ]
              },
              {
                "required": [
                  "recording_location"
                ]
              }
            ]
          }
        }
      }
    },
