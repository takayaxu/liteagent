      "action": "desktop.set_accessibility_scale",
      "tool": {
        "type": "function",
        "function": {
          "name": "adapter__desktop_set_accessibility_scale",
          "description": "Execute the deterministic os.desktop.set_accessibility_scale Adapter action. Pass the documented action params directly as top-level tool arguments. Use only documented parameter names.",
          "parameters": {
            "type": "object",
            "properties": {
              "text_factor": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 3.0,
                "description": "GNOME desktop text scaling factor selected by the model. 1.0 is normal size; choose a value greater than 1.0 when the user requests larger on-screen text."
              },
              "magnifier_factor": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 32.0,
                "description": "GNOME screen magnifier zoom factor selected by the model. A value greater than 1.0 enlarges the visible desktop; this action enables the magnifier and verifies the factor."
              }
            },
            "required": [
              "text_factor",
              "magnifier_factor"
            ],
            "additionalProperties": false
          }
        }
      }
    },
