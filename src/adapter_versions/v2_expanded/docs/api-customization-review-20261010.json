    {
      "domain": "gimp",
      "action": "image.adjust",
      "tool": {
        "type": "function",
        "function": {
          "name": "adapter__image_adjust",
          "description": "Execute the deterministic gimp.image.adjust Adapter action. Adjust brightness, contrast, or saturation of a local image and save the adjusted image to a different file. Supply at least one adjustment; omitted adjustments are zero. This edits the image file, not an image object's appearance inside a presentation. Pass the documented action params directly as top-level tool arguments. Use only documented parameter names.",
          "parameters": {
            "type": "object",
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1,
                "description": "Exact local source image path, such as a PNG or JPEG; not a presentation path or a file URL. Discover an unknown location with filesystem.find first."
              },
              "output_path": {
                "type": "string",
                "minLength": 1,
                "description": "Destination for the adjusted image: a different file from input_path. Use PNG, JPEG, or XCF. Existing output files are replaced; the source is retained for verification."
              },
              "brightness": {
                "type": "number",
                "minimum": -127,
                "maximum": 127,
                "description": "Brightness offset: positive values brighten, negative values darken, and zero leaves brightness unchanged. This is GIMP's -127 to 127 scale, not a percent or target brightness. Fractional values are truncated toward zero."
              },
              "contrast": {
                "type": "number",
                "minimum": -127,
                "maximum": 127,
                "description": "Contrast offset: positive increases, negative decreases, zero leaves it unchanged. GIMP's -127 to 127 scale, not percent; fractional values are truncated toward zero."
              },
              "saturation": {
                "type": "number",
                "minimum": -100,
                "maximum": 100,
                "description": "Relative saturation adjustment: positive increases color intensity, negative decreases it, zero leaves it unchanged, and -100 removes color. Fractional amounts are supported."
              },
              "open_in_gui": {
                "type": "boolean",
                "description": "Defaults to false. True saves a GIMP project and opens it; use an XCF output_path in that mode. For a PNG or JPEG export, omit this field or set it to false."
              }
            },
            "required": [
              "input_path",
              "output_path"
            ],
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "brightness"
                ]
              },
              {
                "required": [
                  "contrast"
                ]
              },
              {
                "required": [
                  "saturation"
                ]
              }
            ]
          }
        }
      }
    },
